{
  "_note": "DSH hooks 配置（claude-code 方言）。command 用绝对路径，避免 CLAUDE_PROJECT_DIR 未设时失效。",
  "_scope": "脚本内部按载荷 cwd 自限：仅约束本 worktree 内的研究会话；区外会话放行并记录。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "read|read_document|read_image|glob|grep|write|edit|bash|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/lge/Desktop/leo-direct-sim/.worktrees/topic-loop-20260910/round/hooks/hook_access_guard.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "subagent|subagent_fork|subagent_codex|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/lge/Desktop/leo-direct-sim/.worktrees/topic-loop-20260910/round/hooks/hook_prompt_scope.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "bash|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/lge/Desktop/leo-direct-sim/.worktrees/topic-loop-20260910/round/hooks/hook_ledger_diagnostic.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}