{
  "_note": "DSH hooks 配置（claude-code 方言）。command 用绝对路径，避免 CLAUDE_PROJECT_DIR 未设时失效。",
  "_scope": "Registered sessions are role-scoped; unknown access to this worktree is denied. No anonymous tickets.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "read|read_document|read_image|glob|grep|ls|write|edit|notebook_edit|bash|shell|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/round/hooks/hook_access_guard.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "bash|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/round/hooks/hook_ledger_diagnostic.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
