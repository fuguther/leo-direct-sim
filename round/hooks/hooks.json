{
  "_note": "本文件为 hook 配置草案，尚未挂载。挂载前请阅读 HOOKS-README.md 与 HOOK-CONTRACT.md。",
  "_scope": "run-scoped：权限由 round/hooks/permissions.json 决定，与全局配置无关。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "read|read_document|read_image|glob|grep|write|edit|bash|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/round/hooks/hook_access_guard.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "subagent|subagent_fork|subagent_codex|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/round/hooks/hook_prompt_scope.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "subagent|subagent_fork|subagent_codex|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/round/hooks/hook_dispatch_register.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "bash|run_code",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/round/hooks/hook_ledger_diagnostic.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}